# Hierarchical Search Chatbot — Environment Variables
# Copy this file to .env and fill in your values

# Azure AI Search
SEARCH_ENDPOINT=https://your-search-service.search.windows.net
SEARCH_INDEX=video-transcripts-hierarchical-v2

# Azure OpenAI
AOAI_ENDPOINT=https://your-openai.openai.azure.com
CHAT_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_TEMPERATURE=0
AZURE_OPENAI_MAX_TOKENS=4096

# Foundry Agent (optional — for agent-based approach)
FOUNDRY_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your_project
FOUNDRY_AGENT_NAME=
FOUNDRY_AGENT_VERSION=1
FOUNDRY_ENABLE_FEEDBACK=true

# Auth (optional)
AUTH_ENABLED=false

# UI
UI_TITLE=Hierarchical Search
UI_CHAT_TITLE=Video Transcript Explorer
